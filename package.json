{
  "name": "skills-hub",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/.worktrees/**' --exclude 'scripts/check-network-boundaries.test.mjs'",
    "rust:fmt": "cd src-tauri && cargo fmt --all",
    "rust:fmt:check": "cd src-tauri && cargo fmt --all -- --check",
    "rust:clippy": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "rust:test": "cd src-tauri && cargo test --features cli",
    "network:check": "node --test scripts/check-network-boundaries.test.mjs && node scripts/check-network-boundaries.mjs",
    "check": "npm run network:check && npm run lint && npm run test && npm run build && npm run rust:fmt:check && npm run rust:clippy && npm run rust:test",
    "preview": "vite preview",
    "version:set": "node scripts/version.mjs set",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "tauri": "tauri",
    "cli:prepare": "node scripts/prepare-cli-sidecar.mjs",
    "tauri:dev": "node scripts/build-desktop.mjs --dev",
    "tauri:icon:desktop": "node scripts/tauri-icon-desktop.mjs",
    "tauri:build": "npm run version:check && node scripts/build-desktop.mjs",
    "tauri:build:mac:dmg": "npm run tauri:build -- --bundles dmg",
    "tauri:build:mac:universal:dmg": "npm run tauri:build -- --target universal-apple-darwin --bundles dmg",
    "tauri:build:win:exe": "npm run tauri:build -- --bundles nsis",
    "tauri:build:win:msi": "npm run tauri:build -- --bundles msi",
    "tauri:build:win:all": "npm run tauri:build -- --bundles msi,nsis",
    "tauri:build:linux:deb": "npm run tauri:build -- --bundles deb",
    "tauri:build:linux:appimage": "npm run tauri:build -- --bundles appimage",
    "tauri:build:linux:all": "npm run tauri:build -- --bundles deb,appimage",
    "tauri:build:local": "npm run tauri:build -- --local-test",
    "tauri:build:local:mac:dmg": "npm run tauri:build:local -- --bundles dmg",
    "tauri:build:local:win:exe": "npm run tauri:build:local -- --bundles nsis",
    "tauri:build:local:win:msi": "npm run tauri:build:local -- --bundles msi",
    "tauri:build:local:win:all": "npm run tauri:build:local -- --bundles msi,nsis",
    "tauri:build:local:linux:deb": "npm run tauri:build:local -- --bundles deb",
    "tauri:build:local:linux:appimage": "npm run tauri:build:local -- --bundles appimage",
    "tauri:build:local:linux:all": "npm run tauri:build:local -- --bundles deb,appimage"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.91.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.5.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.5.3",
    "clsx": "^2.1.1",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.7",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
