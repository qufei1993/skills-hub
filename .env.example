# Local debug builds may read these values from .env or the process environment.
# Release builds ignore runtime values and embed deployment values at compile time.
# OAuth client IDs are public identifiers, but do not commit real deployment values.
# Never add OAuth client secrets here or inject them into the desktop app.
SKILLS_HUB_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
SKILLS_HUB_GITLAB_CLIENT_ID=your_gitlab_oauth_application_id

# Public HTTPS endpoint operated by the Skills Hub project for Gitee OAuth exchange.
SKILLS_HUB_GITEE_AUTH_RELAY_URL=https://auth.example.com
